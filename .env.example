# ==============================================================================
# SOAPI — Environment Variables Configuration (.env)
# ==============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://soapi_user:soapi_secret@localhost:5432/soapi_db
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# Option A: Local S3 (docker-compose on port 9000, 100% Free, Zero Auth):
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=soapi-audio-recordings
S3_FORCE_PATH_STYLE=true

# Option B: Cloudflare R2 (Free Cloud S3 10GB):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<your-r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# S3_BUCKET_NAME=soapi-audio-recordings
# S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Security & Data Retention (UU PDP Compliance)
# ------------------------------------------------------------------------------
PRESIGNED_URL_EXPIRES_SECONDS=900
AUDIO_AUTO_PURGE_HOURS=24
