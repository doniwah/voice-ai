# ==============================================================================
# SOAPI — Environment Variables Configuration (.env)
# ==============================================================================

NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# AI Provider Configuration (Google Gemini / OpenAI)
# ------------------------------------------------------------------------------
# Opsi 1: Google Gemini (Disarankan, cepat & hemat)
GEMINI_API_KEY=your_gemini_api_key_here

# Opsi 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Fast BM25 + Medical Lexical Engine (Nonaktifkan PyTorch berat di VPS)
DISABLE_TORCH_EMBEDDINGS=1

# URL FastAPI Backend untuk dihubungi oleh Node.js Web Gateway
FASTAPI_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=soapi_user
POSTGRES_PASSWORD=soapi_secret
POSTGRES_DB=soapi_db
DATABASE_URL=postgresql://soapi_user:soapi_secret@localhost:5432/soapi_db
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (Audio Medis)
# ------------------------------------------------------------------------------
# Opsi A: S3 Lokal Docker (Port 9000):
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=soapi-audio-recordings
S3_FORCE_PATH_STYLE=true

# Opsi B: Cloudflare R2 (Free Cloud S3 10GB):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<your-r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
# S3_BUCKET_NAME=soapi-audio-recordings
# S3_FORCE_PATH_STYLE=false

# ------------------------------------------------------------------------------
# Security & Data Retention (UU PDP Compliance)
# ------------------------------------------------------------------------------
PRESIGNED_URL_EXPIRES_SECONDS=900
AUDIO_AUTO_PURGE_HOURS=24
